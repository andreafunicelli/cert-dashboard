{% from "_management_ui.html.j2" import error_summary, field_attrs, field_error %}
<section class="panel" aria-labelledby="create-heading">
  <h2 id="create-heading">Create user</h2>
  <p>Create a local user with administrator access.</p>
  {{ error_summary(errors) }}
  {% if error %}<p class="form-error" role="alert">{{ error }}</p>{% endif %}
  <form method="post" action="/users">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    <label for="new-username" id="field-username">Username</label>
    <input id="new-username" name="username" value="{{ values.username }}" maxlength="150" pattern="[A-Za-z0-9._@\-]+" autocomplete="off" required{{ field_attrs(errors, 'username') }}>
    {{ field_error(errors, 'username') }}
    <label for="new-email" id="field-email">Email</label>
    <input id="new-email" name="email" type="email" value="{{ values.email }}" maxlength="254" autocomplete="off" required{{ field_attrs(errors, 'email') }}>
    {{ field_error(errors, 'email') }}
    <label for="new-display" id="field-display_name">Display name (optional)</label>
    <input id="new-display" name="display_name" value="{{ values.display_name }}" maxlength="200" autocomplete="off"{{ field_attrs(errors, 'display_name') }}>
    {{ field_error(errors, 'display_name') }}
    <label for="new-password" id="field-password">Temporary password (at least 12 characters)</label>
    <input id="new-password" name="password" type="password" autocomplete="new-password" minlength="12" required{{ field_attrs(errors, 'password') }}>
    {{ field_error(errors, 'password') }}
    <label for="new-confirm" id="field-confirm_password">Repeat temporary password</label>
    <input id="new-confirm" name="confirm_password" type="password" autocomplete="new-password" minlength="12" required{{ field_attrs(errors, 'confirm_password') }}>
    {{ field_error(errors, 'confirm_password') }}
    <button type="submit">Create user</button>
  </form>
  <p class="hint">The user must change this password at first sign-in. The password is never shown again.</p>
</section>
