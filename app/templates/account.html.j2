{% extends "base.html.j2" %}
{% from "_ui.html.j2" import icon %}
{% block title %}Account · Cert Dashboard{% endblock %}
{% block extra_css %}<link rel="stylesheet" href="/static/pages/account.css">{% endblock %}
{% macro errors(message) %}{% if message %}<p class="form-error" role="alert">{{ message }}</p>{% endif %}{% endmacro %}
{% block content %}
<h1>Account</h1>
<p>Signed in as <strong>{{ username }}</strong>.</p>
<p class="help">Manage your password, sign-in protection and current session.</p>
{% if notice %}<p class="notice" role="status">{{ notice }}</p>{% endif %}
{% if must_change %}<p class="form-error" role="alert">You must change your password before you can use the rest of the application.</p>{% endif %}

<section class="panel" aria-labelledby="password-heading">
  <h2 id="password-heading">Change password</h2>
  {% if can_change_password %}
  {{ errors(password_error) }}
  <form method="post" action="/account/password">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    <label for="pw-current">Current password</label>
    <input id="pw-current" name="current_password" type="password" autocomplete="current-password" required>
    <label for="pw-new">New password (at least 12 characters)</label>
    <input id="pw-new" name="new_password" type="password" autocomplete="new-password" minlength="12" required>
    <label for="pw-confirm">Repeat new password</label>
    <input id="pw-confirm" name="confirm_password" type="password" autocomplete="new-password" minlength="12" required>
    <button type="submit">Change password</button>
  </form>
  <p class="hint">Changing your password signs out every other session.</p>
  {% else %}
  <p>Your password is managed by your directory.</p>
  {% endif %}
</section>

{% if not must_change %}
<section class="panel" aria-labelledby="totp-heading">
  <h2 id="totp-heading">Two-factor authentication</h2>
  {% if enrollment %}
    <div class="secret-once" role="alert">
      <p><strong>Save this now. It is shown once and cannot be displayed again.</strong></p>
      <p>Add the account to your authenticator app using this key (SHA-1, 6 digits, 30 seconds):</p>
      <p><code data-secret>{{ enrollment.secret }}</code></p>
      <p>Or open this provisioning link: <code>{{ enrollment.provisioning_uri }}</code></p>
      <p>Recovery codes (each works once):</p>
      <ul class="codes">{% for item in enrollment.recovery_codes %}<li><code data-recovery-code>{{ item }}</code></li>{% endfor %}</ul>
    </div>
  {% endif %}
  {% if totp_enabled %}
    <p>Two-factor authentication is <strong>enabled</strong>. Recovery codes remaining: <span class="mono">{{ recovery_remaining }}</span>.</p>
    <p><span class="badge badge-ok">{{ icon('ok') }} Protected by two-factor authentication</span></p>
    <p class="help">Each recovery code works once. Keep the codes in a secure place separate from your password.</p>
    {{ errors(enroll_error) }}
    {{ errors(disable_error) }}
    <details class="confirmation"{% if disable_error %} open{% endif %}>
    <summary>Disable two-factor authentication</summary>
    <p>This removes your authenticator and recovery codes. Future sign-ins will require only your password. Every other session will be signed out.</p>
    <form method="post" action="/account/totp/disable">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      <label for="disable-password">Current password</label>
      <input id="disable-password" name="current_password" type="password" autocomplete="current-password" required>
      <div class="actions"><button class="button-destructive" type="submit">Disable two-factor authentication</button><a href="/account">Cancel</a></div>
    </form>
    <p class="hint">Disabling signs out every other session.</p>
    </details>
  {% else %}
    {% if totp_pending %}
      <p>Enrollment is <strong>pending</strong>: enter a code from your authenticator app to finish.</p>
      <p class="help">Confirming enables two-factor authentication and signs out every other session.</p>
      {{ errors(confirm_error) }}
      <form method="post" action="/account/totp/confirm">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
        <label for="confirm-code">6-digit code</label>
        <input id="confirm-code" name="code" inputmode="numeric" maxlength="6" autocomplete="one-time-code" required>
        <button type="submit">Confirm and enable</button>
      </form>
      <p class="hint">Lost the key or codes? Start again below; the pending enrollment is replaced.</p>
    {% else %}
      <p>Two-factor authentication is <strong>not enabled</strong>.</p>
      <p><span class="badge badge-warn">{{ icon('warn') }} Password-only sign-in</span></p>
    {% endif %}
    {{ errors(enroll_error) }}
    {% if totp_pending %}<details class="confirmation"{% if enroll_error %} open{% endif %}><summary>Restart enrollment</summary><p>This replaces the pending key and recovery codes and signs out every other session. Save the replacement codes before continuing.</p>{% endif %}
    <form method="post" action="/account/totp/enroll">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      <label for="enroll-password">Current password</label>
      <input id="enroll-password" name="current_password" type="password" autocomplete="current-password" required>
      <div class="actions"><button type="submit"{% if totp_pending %} class="button-destructive"{% endif %}>{% if totp_pending %}Restart enrollment{% else %}Set up two-factor authentication{% endif %}</button>{% if totp_pending %}<a href="/account">Cancel</a>{% endif %}</div>
    </form>
    {% if totp_pending %}</details>{% endif %}
  {% endif %}
</section>
{% endif %}

<section class="panel" aria-labelledby="sessions-heading">
<h2 id="sessions-heading">Current session</h2>
<p>Sign out of this browser only. Other sessions stay signed in.</p>
<form method="post" action="/logout">
  <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
  <button class="button-secondary" type="submit">Sign out</button>
</form>
</section>
{% endblock %}
