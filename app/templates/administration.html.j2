{% extends "base.html.j2" %}
{% block title %}Administration · Cert Dashboard{% endblock %}
{% block content %}
{% from "_operations_ui.html.j2" import page_header %}
{{ page_header('Administration', 'What is configured, what is missing and where to change it.') }}
{% for group in groups %}
<section class="hub-group" aria-labelledby="hub-group-{{ loop.index }}">
  <h2 id="hub-group-{{ loop.index }}">{{ group.name }}</h2>
  <dl class="fields">
  {% for entry in group.entries %}
    <dt><a href="{{ entry.href }}">{{ entry.label }}</a></dt>
    <dd>{{ entry.status }}</dd>
  {% endfor %}
  </dl>
</section>
{% endfor %}
{% endblock %}
