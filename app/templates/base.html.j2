<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{% block title %}Cert Dashboard{% endblock %}</title>
  <link rel="stylesheet" href="/static/app.css">
  <script src="/static/htmx.min.js" defer></script>
</head>
<body>
<header><a class="brand" href="/">Cert Dashboard</a>
  <nav aria-label="Main">
  {% for item in navigation %}
    {% if item.enabled %}<a href="{{ item.url }}">{{ item.label }}</a>
    {% else %}<span aria-disabled="true" title="{{ item.reason }}">{{ item.label }}</span>{% endif %}
  {% endfor %}
  </nav>
  {% if user %}<details><summary>{{ user.display_name }}</summary>
    <a href="/account">Account</a>
    <a href="/users">Users</a>
  </details>{% endif %}
</header>
{% block status_banner %}{% if status_banner %}<aside role="status">{{ status_banner }} <a href="/settings?tab=status">Details</a></aside>{% endif %}{% if request is defined and request.state.worker_stale %}<aside role="status" class="banner-critical" data-banner="worker">Worker is not running (last heartbeat > 5 minutes) <a href="/settings?tab=status">Details</a></aside>{% endif %}{% endblock %}
{% if flash is defined and flash %}<aside role="status" class="notice" data-banner="flash"><p>Notes on the last action:</p><ul>{% for note in flash %}<li>{{ note }}</li>{% endfor %}</ul></aside>{% endif %}
<main>{% block content %}{% endblock %}</main>
{% block scripts %}{% endblock %}
</body>
</html>
