{# Shared infrastructure presentation; inventory matches are not desired deployments. #}
{% from "_ui.html.j2" import icon %}
{% macro discovery_state(status, at) -%}
{% if status == 'ok' %}<span class="badge badge-ok">{{ icon('ok') }}Discovered</span>
{% elif status in ('failed', 'unreachable', 'error') %}<span class="badge badge-danger">{{ icon('danger') }}{{ 'Unreachable' if status == 'unreachable' else 'Discovery failed' }}</span>
{% elif status or at %}<span class="badge badge-info">{{ icon('info') }}{{ status or 'Unknown result' }}</span>
{% else %}<span class="badge">{{ icon('info') }}Never discovered</span>{% endif %}
{%- endmacro %}
{% macro owner_mode(owner, group, mode) -%}
{% if owner or group or mode %}{{ owner or '?' }}:{{ group or '?' }} {{ mode or '?' }}{% else %}—{% endif %}
{%- endmacro %}
{% macro binding_state(b, on_server=false) -%}
{% if b.match_state in ('key_mismatch', 'missing_file') %}
<span class="badge {{ 'badge-warn' if b.match_state == 'key_mismatch' else 'badge-danger' }}">{{ icon('warn' if b.match_state == 'key_mismatch' else 'danger') }}{{ 'Drift: ' if b.match_state == 'key_mismatch' else 'File failure: ' }}<a href="/bindings/help#{{ b.match_state }}" data-match-state="{{ b.match_state }}">{{ b.match_state }}</a></span>
{% elif b.match_state == 'matched' %}<span class="badge badge-ok" data-match-state="{{ b.match_state }}">{{ icon('ok') }}Inventory match</span>
{% else %}<span class="badge" data-match-state="{{ b.match_state }}">{{ icon('info') }}Unknown certificate</span>{% endif %}
{% if on_server and b.match_state in ('key_mismatch', 'missing_file') %}<p class="help"><a href="/bindings/help">How to fix it</a></p>{% endif %}
{%- endmacro %}
{% macro binding_cells(b, tz, on_server=false) %}
<td class="binding-relationship">
  <strong>{{ b.vhost_name }}</strong>{% if not b.is_active %} <small>{{ '(inactive)' if on_server else '(retired)' }}</small>{% endif %}
  <p>on <a href="/servers/{{ b.server_id }}">{{ b.server }}</a></p>
  <p>Port <span class="mono">{{ b.port }}</span> · {{ b.webserver }}</p>
  <p class="help">Configured SNI / virtual-host names: {{ b.vhost_names | join(', ') or 'Not recorded' }}</p>
  <details><summary>Configuration and permissions</summary>
    <dl class="fields">
      <dt>Config file</dt><dd><code>{{ b.config_file }}</code></dd>
      <dt>Certificate owner / mode</dt><dd><code>{{ owner_mode(b.cert_owner, b.cert_group, b.cert_mode) }}</code></dd>
      <dt>Key owner / mode</dt><dd><code>{{ owner_mode(b.key_owner, b.key_group, b.key_mode) }}</code></dd>
    </dl>
  </details>
</td>
<td class="binding-observed">
  <p class="help">Certificate path</p><code>{{ b.cert_path }}</code>
  <p class="help">On-disk certificate SHA-256</p>
  {% if b.on_disk_fingerprint %}<code class="binding-hash">{{ b.on_disk_fingerprint }}</code>{% else %}<p>Not available</p>{% endif %}
  <details><summary>Key and chain paths</summary>
    <dl class="fields"><dt>Key</dt><dd><code>{{ b.key_path }}</code></dd>
      <dt>Chain</dt><dd>{% if b.chain_path %}<code>{{ b.chain_path }}</code>{% else %}Not configured{% endif %}</dd>
      <dt>On-disk key public SHA-256</dt><dd><code>{{ b.on_disk_key_public_sha256 or 'Not available' }}</code></dd>
    </dl>
  </details>
</td>
<td class="binding-inventory">
  {% if b.certificate_id %}<a href="/certificates/{{ b.certificate_id }}">{{ b.certificate_common_name or 'Certificate' }}</a><p class="help">Inventory match <span class="mono">#{{ b.certificate_id }}</span></p>
  {% else %}<p>No inventory match recorded.</p>{% endif %}
  {% if b.match_state == 'key_mismatch' %}<p>The configured key does not belong to the on-disk certificate.</p><p class="help">Expected: a private key belonging to this certificate.</p>
  {% elif b.match_state == 'missing_file' %}<p>Expected: a readable certificate at the configured path.</p><p>The certificate file is missing or unreadable.</p>
  {% elif b.match_state == 'matched' %}<p>Certificate is in inventory; configured key belongs to it.</p>{% endif %}
  <p class="help">Desired deployment and expected fingerprint are not supplied by this view. An inventory match is not a desired-state comparison.</p>
</td>
<td class="binding-result">
  {{ binding_state(b, on_server) }}
  <p class="help">Last seen {{ time_tag(b.last_seen_at, tz) }}</p>
  {% if b.stale %}<p><span class="badge badge-warn" data-stale="true" title="The last discovery of this server did not succeed">{{ icon('warn') }}stale since {{ time_tag(b.last_seen_at, tz) }}</span></p><p class="help">Stored observation, not a current host verdict.</p>{% endif %}
  {% if b.notes %}<p class="binding-note">{{ b.notes }}</p>{% endif %}
  {% if b.match_state == 'unknown' and b.is_active %}<p><a href="/certificates/import?from_binding={{ b.id }}">Import as certificate</a></p>{% endif %}
</td>
{% endmacro %}
