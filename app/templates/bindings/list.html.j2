{% extends "base.html.j2" %}
{% block title %}Bindings · Cert Dashboard{% endblock %}
{% block extra_css %}<link rel="stylesheet" href="/static/pages/bindings.css">{% endblock %}
{% from "bindings/_presentation.html.j2" import binding_cells %}
{% block content %}
<h1>Where is a certificate used?</h1>
<p>Follow each certificate from its inventory match to the host, configured path, port and SNI names. Discovery describes files on disk; use endpoint scans to check what is served over TLS.</p>
<section class="panel wide" aria-label="Filters">
  <form method="get" action="/bindings" class="filters">
    <label>Certificate id <input type="number" name="certificate_id" min="1" value="{{ values.certificate_id or '' }}"></label>
    <label>Server id <input type="number" name="server_id" min="1" value="{{ values.server_id or '' }}"></label>
    <label>Group <input name="group" value="{{ values.group or '' }}" maxlength="200"></label>
    <label>Virtual host <input type="search" name="vhost" value="{{ values.vhost or '' }}" maxlength="200" placeholder="Name contains"></label>
    <label>Web server
      <select name="webserver">
        <option value="">Any</option>
        {% for name in webservers %}<option value="{{ name }}"{% if values.webserver == name %} selected{% endif %}>{{ name }}</option>{% endfor %}
      </select></label>
    <label>Match
      <select name="match_state">
        <option value="">Any</option>
        {% for name in match_states %}<option value="{{ name }}"{% if values.match_state == name %} selected{% endif %}>{{ name }}</option>{% endfor %}
      </select></label>
    <label>Bindings
      <select name="active">
        <option value="true"{% if not values.active %} selected{% endif %}>Active</option>
        <option value="false"{% if values.active == "false" %} selected{% endif %}>Retired</option>
        <option value="all"{% if values.active == "all" %} selected{% endif %}>All</option>
      </select></label>
    <input type="hidden" name="sort" value="{{ sort_state }}">
    <input type="hidden" name="page_size" value="{{ page.page_size }}">
    <button type="submit">Apply filters</button>
    <a href="/bindings">Reset</a>
  </form>
</section>

<div class="list-summary" data-total="{{ page.total }}"><span class="mono">{{ page.total }} binding{{ "" if page.total == 1 else "s" }}</span>
  · <a href="{{ export_url }}" download="bindings.json">Export list as JSON</a>
  · <a href="/bindings/help">What do the match states mean?</a></div>

{% if page.items %}
<div class="table-wrap">
<table class="bindings">
  <thead><tr>
    <th scope="col">Relationship · <a href="{{ sort_url('server') }}">Server</a> / <a href="{{ sort_url('vhost') }}">Virtual host</a></th>
    <th scope="col">Observed on disk</th>
    <th scope="col">Inventory / expectation</th>
    <th scope="col"><a href="{{ sort_url('match_state') }}">Match</a> / <a href="{{ sort_url('last_seen_at') }}">Last seen</a></th>
  </tr></thead>
  <tbody>
  {% for b in page.items %}
  <tr class="binding-row{% if b.match_state == 'key_mismatch' %} binding-drift{% elif b.match_state == 'missing_file' %} row-attention{% elif not b.is_active %} row-inactive{% endif %}" data-binding-id="{{ b.id }}" data-vhost="{{ b.vhost_name }}">
    {{ binding_cells(b, tz) }}
  </tr>
  {% endfor %}
  </tbody>
</table>
</div>
{% else %}
<section class="empty-state"><h2>No bindings match these filters</h2><p><a href="/bindings">Clear the filters</a> or <a href="/servers">check discovery on the server</a>. An empty filtered list does not mean discovery found no changes.</p></section>
{% endif %}

<nav class="pager" aria-label="Pages">
  {% if page.page > 1 %}<a rel="prev" href="{{ page_url(page.page - 1) }}">Previous</a>{% endif %}
  <span>Page <span class="mono">{{ page.page }}</span> of <span class="mono">{{ pages }}</span></span>
  {% if page.page < pages %}<a rel="next" href="{{ page_url(page.page + 1) }}">Next</a>{% endif %}
</nav>
{% endblock %}
