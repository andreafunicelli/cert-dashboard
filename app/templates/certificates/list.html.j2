{% extends "base.html.j2" %}
{% block title %}Certificates · Cert Dashboard{% endblock %}
{% block extra_css %}<link rel="stylesheet" href="/static/pages/certificates.css">{% endblock %}
{% block content %}
{% from "_inventory_ui.html.j2" import certificate_state %}
{% set filter_labels = {'search': 'Search', 'status': 'Status', 'expiry': 'Expires', 'issuer': 'Issuer', 'team': 'Team', 'owner': 'Owner', 'has_key': 'Private key', 'has_bindings': 'Bindings', 'renewal_state': 'Renewal'} %}
{% set expiry_labels = {'expired': 'Already expired', 'lt7': 'In less than 7 days', 'lt30': 'In 7 to 30 days', 'lt60': 'In 30 to 60 days'} %}
{% set active = namespace(count=0, extra=0) %}
{% for key in filter_labels %}{% if values.get(key) %}{% set active.count = active.count + 1 %}{% if key != 'search' %}{% set active.extra = active.extra + 1 %}{% endif %}{% endif %}{% endfor %}
<header class="page-header">
  <div><h1>Certificates</h1><p class="page-subtitle" data-total="{{ page.total }}">{{ page.total }} certificate{{ "" if page.total == 1 else "s" }}</p></div>
  <div class="page-actions">
    <a class="button" href="/certificates/import">Import certificate</a>
    <details class="action-menu"><summary>More actions</summary><div class="action-menu-items">
      <a href="{{ export_url }}" download="certificates.json">Export list as JSON</a>
    </div></details>
  </div>
</header>
<section class="filter-bar" aria-label="Filters">
  <form method="get" action="/certificates">
    <div class="filter-toolbar">
      <label class="filter-search">Search <input type="search" name="search" value="{{ values.search or '' }}" maxlength="200" placeholder="CN, SAN, serial or fingerprint"></label>
      <button class="button-secondary" type="submit">Search</button>
    </div>
    <details class="filter-disclosure">
      <summary>Filters{% if active.extra %} · {{ active.extra }}{% endif %}</summary>
      <div class="filters">
        <label>Status
          <select name="status"><option value="">Any</option>
            {% for item in statuses %}<option value="{{ item }}"{% if values.status == item %} selected{% endif %}>{{ item }}</option>{% endfor %}
          </select></label>
        <label>Expires
          <select name="expiry"><option value="">Any</option>
            {% for item in buckets %}<option value="{{ item }}"{% if values.expiry == item %} selected{% endif %}>{{ expiry_labels[item] }}</option>{% endfor %}
          </select></label>
        <label>Issuer <input name="issuer" value="{{ values.issuer or '' }}" maxlength="200"></label>
        <label>Team <input name="team" value="{{ values.team or '' }}" maxlength="200"></label>
        <label>Owner <input name="owner" value="{{ values.owner or '' }}" maxlength="200"></label>
        <label>Private key
          <select name="has_key"><option value="">Any</option>
            <option value="true"{% if values.has_key == "true" %} selected{% endif %}>Present</option>
            <option value="false"{% if values.has_key == "false" %} selected{% endif %}>Absent</option></select></label>
        <label>Bindings
          <select name="has_bindings"><option value="">Any</option>
            <option value="true"{% if values.has_bindings == "true" %} selected{% endif %}>Has bindings</option>
            <option value="false"{% if values.has_bindings == "false" %} selected{% endif %}>No bindings</option></select></label>
        <label>Renewal
          <select name="renewal_state"><option value="">Any</option>
            {% for item in renewal_states %}<option value="{{ item }}"{% if values.renewal_state == item %} selected{% endif %}>{{ item }}</option>{% endfor %}
          </select></label>
        <button class="button-secondary" type="submit">Apply filters</button>
      </div>
    </details>
    <input type="hidden" name="sort" value="{{ sort_state }}">
    <input type="hidden" name="page_size" value="{{ page.page_size }}">
  </form>
  {% if active.count %}
  <div class="applied-filters" aria-label="Applied filters">
    <a href="/certificates">Reset</a>
    {% for key, label in filter_labels.items() %}{% if values.get(key) %}
      {% set remaining = namespace(pairs=[]) %}
      {% for name, value in values.items() %}{% if name != key and name != 'page' and value %}{% set remaining.pairs = remaining.pairs + [(name, value)] %}{% endif %}{% endfor %}
      {% set display = expiry_labels.get(values[key], values[key]) if key == 'expiry' else ({'true': 'Present', 'false': 'Absent'}.get(values[key], values[key]) if key == 'has_key' else ({'true': 'Has bindings', 'false': 'No bindings'}.get(values[key], values[key]) if key == 'has_bindings' else values[key])) %}
      <a class="chip filter-chip" href="/certificates{% if remaining.pairs %}?{{ remaining.pairs | urlencode }}{% endif %}" aria-label="Remove {{ label }} filter: {{ display }}">{{ label }}: {{ display }} {{ icon('danger') }}</a>
    {% endif %}{% endfor %}
  </div>
  {% endif %}
</section>

{% if page.items %}
<div class="table-wrap certificate-table-wrap" tabindex="0" role="region" aria-label="Certificate results">
<table class="certificates">
  <thead><tr>
    <th scope="col"><a href="{{ sort_url('common_name') }}">Common name</a></th>
    <th scope="col"><a href="{{ sort_url('issuer_cn') }}">Issuer</a></th>
    <th scope="col" class="numeric"><a href="{{ sort_url('not_after') }}">Expires</a></th>
    <th scope="col"><a href="{{ sort_url('status') }}">Status</a></th>
    <th scope="col" class="numeric">Bindings</th>
    <th scope="col">Actions</th>
  </tr></thead>
  <tbody>
  {% for cert in page.items %}
  <tr data-cn="{{ cert.common_name }}">
    <td class="certificate-name"><a href="/certificates/{{ cert.id }}" title="{{ cert.common_name }}">{{ cert.common_name }}</a></td>
    <td class="certificate-issuer" title="{{ cert.issuer_cn }}">{{ cert.issuer_cn }}</td>
    <td class="numeric">{{ time_tag(cert.not_after, tz) }}</td>
    <td>{{ certificate_state(cert, now, compact=true) }}</td>
    <td class="numeric">{{ cert.binding_count }}</td>
    <td><details class="action-menu"><summary aria-label="Actions for {{ cert.common_name }}">Actions</summary>
      <div class="action-menu-items">
        <a href="/certificates/{{ cert.id }}">Details</a>
        <form method="post" action="/certificates/{{ cert.id }}/scan"><input type="hidden" name="csrf_token" value="{{ csrf_token }}"><button class="button-secondary" type="submit">Scan now</button></form>
        <a href="/certificates/{{ cert.id }}/leaf.pem">Download certificate</a>
        <a class="action-destructive" href="/certificates/{{ cert.id }}#status-panel">Change lifecycle status…</a>
        <p class="help">Deletion is unavailable. Revoke or supersede from the detail page with confirmation.</p>
      </div>
    </details></td>
  </tr>
  {% endfor %}
  </tbody>
</table>
</div>
{% else %}
<div class="empty-state"><h2>No matching certificates</h2><p>No certificates match these filters. <a href="/certificates/import">Import a certificate</a> or <a href="/certificates">clear the filters</a>.</p></div>
{% endif %}

<nav class="pager" aria-label="Pages">
  {% if page.page > 1 %}<a rel="prev" href="{{ page_url(page.page - 1) }}">Previous</a>{% endif %}
  <span aria-current="page">Page <span class="mono">{{ page.page }}</span> of <span class="mono">{{ pages }}</span></span>
  {% if page.page < pages %}<a rel="next" href="{{ page_url(page.page + 1) }}">Next</a>{% endif %}
</nav>
{% endblock %}
