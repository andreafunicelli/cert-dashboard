{% extends "base.html.j2" %}
{% from "_ui.html.j2" import icon %}
{% block title %}Jobs · Cert Dashboard{% endblock %}
{% block extra_css %}<link rel="stylesheet" href="/static/pages/deploy.css">{% endblock %}
{% block content %}
{% from "_operations_ui.html.j2" import page_header, more_actions, filters %}
{% call page_header('Jobs', 'Track queued, running and finished operations, newest first.') %}
  <a class="button" href="/deploy">Plan a deployment</a>
  {% call more_actions() %}<a href="/audit?target_type=job">Job audit history</a>{% endcall %}
{% endcall %}
<p class="hint">A rollout that rolled a host back is listed as
<code>rolled_back</code> — a host state, not a job status — so it is never counted twice as a failure. Open a
deployment for the full record; other jobs open their audit entries.</p>

{% call filters('/deploy/jobs', values, {'outcome': 'Outcome', 'type': 'Job type'}) %}
    <label>Outcome
      <select name="outcome"><option value="">Any</option>
        {% for item in outcomes %}<option value="{{ item }}"{% if values.outcome == item %} selected{% endif %}>{{ item }}</option>{% endfor %}
      </select></label>
    <label>Job type
      <select name="type"><option value="">Any</option>
        {% for item in types %}<option value="{{ item }}"{% if values.type == item %} selected{% endif %}>{{ item }}</option>{% endfor %}
      </select></label>
    {% if values.page_size %}<input type="hidden" name="page_size" value="{{ values.page_size }}">{% endif %}
{% endcall %}

<div class="list-summary" data-total="{{ page.total }}"><span class="mono">{{ page.total }}</span> job{{ "" if page.total == 1 else "s" }} · Finished jobs keep their per-host record.</div>

{% if page.items %}
<div class="table-wrap">
<table class="jobs">
  <thead><tr>
    <th scope="col">Type</th>
    <th scope="col">Target</th>
    <th scope="col">Outcome</th>
    <th scope="col">Hosts</th>
    <th scope="col">Actor</th>
    <th scope="col" class="numeric">Created</th>
    <th scope="col">Details</th>
  </tr></thead>
  <tbody>
  {% for job in page.items %}
  <tr class="job{% if job.outcome in ('failed', 'rolled_back') %} job-failed row-attention{% endif %}" data-job-id="{{ job.job_id }}">
    <td>{{ job.type }}</td>
    <td>{% if job.certificate_id %}<a href="/certificates/{{ job.certificate_id }}">{{ job.certificate_cn }}</a>{% else %}—{% endif %}</td>
    <td><span class="badge {{ 'badge-danger' if job.outcome in ('failed', 'rolled_back') else 'badge-ok' if job.outcome == 'succeeded' else 'badge-info' }}" data-outcome="{{ job.outcome }}" data-status="{{ job.status }}">{{ icon('danger' if job.outcome in ('failed', 'rolled_back') else 'ok' if job.outcome == 'succeeded' else 'info') }} {{ job.outcome }}</span></td>
    <td>{% if job.hosts %}<div class="host-outcomes">{% for host in job.hosts %}<span class="host-outcome" data-host="{{ host.hostname }}" data-status="{{ host.status }}"><span class="mono">{{ host.hostname }}</span> <span class="badge {{ 'badge-danger' if host.status in ('failed', 'rolled_back') else 'badge-ok' if host.status == 'succeeded' else 'badge-info' }}">{{ host.status }}</span></span>{% if not loop.last %}<br>{% endif %}{% endfor %}</div>{% if job.hosts_omitted %}<p class="help" data-hosts-omitted="{{ job.hosts_omitted }}">+{{ job.hosts_omitted }} more host{{ "" if job.hosts_omitted == 1 else "s" }} — open the deployment for the full record</p>{% endif %}<p class="help">{% for key in ('succeeded', 'failed', 'rolled_back', 'skipped', 'pending') %}<span class="mono" data-host-total="{{ key }}">{{ job.totals[key] }}</span> {{ key }}{% if not loop.last %} · {% endif %}{% endfor %}</p>{% else %}—{% endif %}</td>
    <td>{{ job.actor }}</td>
    <td class="numeric">{{ time_tag(job.created_at, tz) }}</td>
    <td><a href="{{ job.href }}" aria-label="Details for the {{ job.type }} job">Details</a></td>
  </tr>
  {% endfor %}
  </tbody>
</table>
</div>
{% else %}
<section class="empty-state"><h2>No jobs match these filters</h2><p>Jobs appear here as discovery, scans, deployments and cleanups run.</p><a href="/deploy/jobs">Clear the filters</a></section>
{% endif %}

<nav class="pager" aria-label="Pages">
  {% if page.page > 1 %}<a rel="prev" href="{{ page_url(page.page - 1) }}">Previous</a>{% endif %}
  <span class="mono" aria-current="page">Page {{ page.page }} of {{ pages }}</span>
  {% if page.page < pages %}<a rel="next" href="{{ page_url(page.page + 1) }}">Next</a>{% endif %}
</nav>
{% endblock %}
