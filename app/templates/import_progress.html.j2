{% extends "base.html.j2" %}
{% block title %}Import from server · Cert Dashboard{% endblock %}
{% block content %}
<section class="panel" id="import-progress">
  <h1>Import from server</h1>
  <p>Endpoint <code>{{ job.endpoint }}</code>{% if job.sni %} (SNI <code>{{ job.sni }}</code>){% endif %}</p>
  {% block status %}
  <div id="import-status" data-status="{{ job.status }}" aria-live="polite"{% if job.polling %} hx-get="/imports/{{ job.id }}/progress" hx-trigger="every 2s" hx-swap="outerHTML"{% endif %}>
    {% if job.status == "queued" %}
    <p role="status">Queued. The worker will connect shortly.</p>
    {% elif job.status == "running" or job.status == "paused" %}
    <p role="status">Running. The worker is retrieving the certificate chain.</p>
    {% elif job.status == "retrying" %}
    <p role="status">The server could not be reached (attempt {{ job.attempt }} of {{ job.max_attempts }}). The worker will retry automatically.</p>
    {% if job.error_message %}<p class="form-error">{{ job.error_message }}</p>{% endif %}
    {% elif job.status == "succeeded" %}
    {% if job.certificate_id %}
    <p role="status">{% if job.created %}Certificate imported.{% else %}Certificate already in inventory.{% endif %}
      <a href="/certificates/{{ job.certificate_id }}">View certificate</a></p>
    <p>The endpoint now expects this certificate.</p>
    {% else %}
    <p role="status">The import finished.</p>
    {% endif %}
    {% elif job.status == "cancelled" %}
    <p role="status">The import was cancelled.</p>
    {% else %}
    <p class="form-error" role="alert">The import failed{% if job.error_message %}: {{ job.error_message }}{% endif %}</p>
    {% endif %}
    <p><a href="/imports/{{ job.id }}">Refresh</a> · <a href="/certificates/import">Back to import</a></p>
  </div>
  {% endblock %}
</section>
{% endblock %}
