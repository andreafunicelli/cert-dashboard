{% extends "base.html.j2" %}
{% block title %}Two-factor verification · Cert Dashboard{% endblock %}
{% block content %}
<section class="panel narrow">
  <h1>Two-factor verification</h1>
  <p>Enter the 6-digit code from your authenticator app, or one of your recovery codes.</p>
  {% if error %}<p class="form-error" role="alert">{{ error }}</p>{% endif %}
  <form method="post" action="/login/2fa">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    <label for="code">Code</label>
    <input id="code" name="code" maxlength="128" autocomplete="one-time-code" inputmode="text" required autofocus>
    <button type="submit">Verify</button>
  </form>
  <form method="post" action="/logout" class="inline">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    <button type="submit" class="link">Cancel and sign out</button>
  </form>
  <p class="hint">Lost your device and codes? Contact another admin.</p>
</section>
{% endblock %}
