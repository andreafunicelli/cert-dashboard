{% extends "base.html.j2" %}
{% from "_ui.html.j2" import icon %}
{% block title %}Overview · Cert Dashboard{% endblock %}
{% block extra_css %}<link rel="stylesheet" href="/static/pages/overview.css">{% endblock %}
{% block content %}
<header class="page-header"><div><h1>Overview</h1><p class="page-subtitle">Track TLS certificates, reconcile endpoints and follow renewals and deployments.</p></div></header>
<section aria-labelledby="attention-heading" class="work-section">
<h2 id="attention-heading">Needs attention</h2>
{% set deployment_attention = queue.deploy_jobs_failed + queue.deploy_jobs_rolled_back %}
{% if queue.certificates_expired or queue.certificates_expiring_7d or queue.endpoints_mismatch or deployment_attention %}
<div class="table-wrap"><table class="work-queue"><thead><tr><th scope="col">Work to review</th><th scope="col" class="numeric">Count</th><th scope="col">Next step</th></tr></thead><tbody>
{% for count, label, href, action, kind in [
  (queue.certificates_expired, 'Expired certificates', '/certificates?expiry=expired&status=active', 'Review expired certificates', 'danger'),
  (queue.certificates_expiring_7d, 'Certificates expiring in < 7 days', '/certificates?expiry=lt7&status=active', 'Prepare renewals', 'warn'),
  (queue.endpoints_mismatch, 'Observed certificate differs from stored certificate', '/scans?status=mismatch', 'Review mismatched endpoints', 'warn')
] %}{% if count %}<tr><td><span class="badge badge-{{ kind }}">{{ icon(kind) }} {{ label }}</span></td><td class="numeric">{{ count }}</td><td><a href="{{ href }}">{{ action }}</a></td></tr>{% endif %}{% endfor %}
{% if deployment_attention %}
<tr>
  <td><span class="badge badge-danger">{{ icon('danger') }} Deployments failed or rolled back</span></td>
  <td class="numeric">{{ deployment_attention }}</td>
  <td>
    {% if queue.deploy_jobs_failed %}<a href="/deploy/jobs?type=deploy&amp;outcome=failed">Review failed (<span class="mono">{{ queue.deploy_jobs_failed }}</span>)</a>{% endif %}
    {% if queue.deploy_jobs_failed and queue.deploy_jobs_rolled_back %}<br>{% endif %}
    {% if queue.deploy_jobs_rolled_back %}<a href="/deploy/jobs?type=deploy&amp;outcome=rolled_back">Review rolled back (<span class="mono">{{ queue.deploy_jobs_rolled_back }}</span>)</a>{% endif %}
  </td>
</tr>
{% endif %}
</tbody></table></div>
{% else %}<p>Nothing needs attention in the work queue.</p>{% endif %}
<p class="help">Recorded results, not live probes. Other TLS findings are in Inventory and history below.</p>
</section>
<section aria-labelledby="flight-heading" class="work-section" id="in-flight">
<h2 id="flight-heading">In flight</h2>
<ul class="flight-summary plain">
<li><a href="/renewals?state=awaiting_certificate"><span class="mono">{{ queue.renewals_awaiting_certificate }}</span> renewal{{ '' if queue.renewals_awaiting_certificate == 1 else 's' }} awaiting an issued certificate</a></li>
<li><a href="/deploy/jobs?type=scan&amp;outcome=running"><span class="mono">{{ queue.scans_running }}</span> running scan{{ '' if queue.scans_running == 1 else 's' }}</a></li>
<li><a href="/deploy/jobs?type=deploy&amp;outcome=running"><span class="mono">{{ queue.deploys_running }}</span> deployment{{ '' if queue.deploys_running == 1 else 's' }} in progress</a></li>
</ul>
<p class="help">Awaiting includes draft, CSR generated and submitted. <a href="/renewals">Review all renewal stages</a>.</p>
</section>
<div class="system-heading"><h2>System</h2><a href="/settings?tab=status">Status details</a></div>
{% block status_strip %}
{% set status = snapshot.status %}
<section class="status-strip" data-status-strip="true" aria-label="Status">
  <div><strong>Worker</strong> <span class="badge {{ 'badge-ok' if status.worker == 'ok' else 'badge-warn' }}">{{ icon('ok' if status.worker == 'ok' else 'warn') }} {{ status.worker }}</span></div>
  <div><strong>Last discovery</strong> <span data-last-discovery>{% if status.last_discovery_at %}{{ time_tag(status.last_discovery_at, tz) }}{% else %}never{% endif %}</span></div>
  <div><strong>Last digest</strong> {% if status.last_digest_at %}{{ time_tag(status.last_digest_at, tz) }}{% else %}never{% endif %}</div>
  <div><strong>Inventory</strong> <span class="mono">{{ setup.host_counts[0] }}</span> active hosts (<span class="mono">{{ setup.host_counts[1] }}</span> manual, <span class="mono">{{ setup.host_counts[2] }}</span> repository){% if status.inventory_rev %}, revision <code title="{{ status.inventory_rev }}">{{ status.inventory_rev[:12] }}</code>{% if status.inventory_rev_age_hours is not none %} (<span class="mono">{{ status.inventory_rev_age_hours }}</span> h old){% endif %}{% else %} · No repository (optional){% endif %}</div>
</section>
{% endblock %}
{% if setup is defined and not setup.complete %}
<details class="setup-checklist" data-setup-done="{{ setup.done }}"{% if not setup.certificates %} open{% endif %}>
  <summary>Setup: {{ setup.done }} of 6 steps done</summary>
  <ol>
    {% for step in setup_steps %}
    <li data-setup-step="{{ loop.index }}" data-done="{{ 'true' if step.done else 'false' }}">
      <span class="badge {{ 'badge-ok' if step.done else 'badge-info' }}">{{ icon('ok' if step.done else 'info') }}{{ 'Done' if step.done else 'To do' }}</span>
      {% if (step.worker_fact | default(false)) and not setup.worker_reporting %}<span class="hint">Worker not reporting</span>{% endif %}
      <span>{{ step.label }}</span>
      {% if not step.done %} · <a href="{{ step.href }}">{{ step.action }}</a>{% if step.secondary | default(false) %} · <a href="{{ step.secondary[1] }}">{{ step.secondary[0] }}</a>{% endif %}{% endif %}
    </li>
    {% endfor %}
  </ol>
</details>
{% endif %}
<details class="filter-disclosure overview-details">
<summary>Inventory and history · all counters and recent work</summary>
<p class="help">Worker: {% if snapshot.status.last_heartbeat_at %}Last heartbeat {{ time_tag(snapshot.status.last_heartbeat_at, tz) }}{% else %}No heartbeat recorded{% endif %}. <a href="/settings?tab=status">Worker details</a></p>
<h2>Certificate expiry</h2>
<section class="counters" aria-label="Certificate expiry">
  {% for counter in counters %}
  {% set kind = 'danger' if counter.key in ['expired', 'lt7'] else 'warn' if counter.key == 'lt30' else 'ok' if counter.key == 'total_active' else 'info' %}
  <a class="counter counter-{{ counter.key }}" data-counter="{{ counter.key }}" href="{{ counter.href }}"><strong>{{ counter.count }}</strong><span class="badge badge-{{ kind }}">{{ icon(kind) }} {{ counter.label }}</span></a>
  {% endfor %}
</section>
{% block tls_health %}
{% set failures = snapshot.recent_jobs | selectattr('status', 'equalto', 'failed') | list %}
{% if failures %}
<aside class="banner banner-critical overview-failures" role="status">
  <strong>{{ icon('danger') }} Recent failures</strong>
  <ul>{% for job in failures %}<li><a href="{{ job.href }}">{{ job.type }}{% if job.summary %}: {{ job.summary }}{% endif %}</a> — {{ time_tag(job.finished_at, tz) }}</li>{% endfor %}</ul>
  <p class="help">Failures among the most recent jobs, not a complete failure history.</p>
</aside>
{% endif %}
<h2>TLS health</h2>
<section class="counters" aria-label="TLS health">
  {% for counter in tls_counters %}
  {% set kind = 'ok' if counter.key == 'ok' else 'warn' if counter.key in ['never_scanned', 'unknown_certificates'] else 'danger' %}
  <a class="counter tls-counter tls-{{ counter.key }}" data-tls="{{ counter.key }}" href="{{ counter.href }}"><strong>{{ counter.count }}</strong><span class="badge badge-{{ kind }}">{{ icon(kind) }} {{ counter.label }}</span></a>
  {% endfor %}
</section>
<p class="help">Latest recorded results, not a live probe. Scan freshness is not summarized here; <a href="/scans">check last-scan times in Scans</a>. Never scanned opens the full endpoint list.</p>
{% endblock %}
<nav class="actions" aria-label="Overview actions"><a class="button button-secondary" href="/certificates">Review certificates</a><a class="button button-secondary" href="/scans">Review scans</a><a href="/audit?target_type=job">Job history</a></nav>
{% block recent_jobs %}
<h2>Recent jobs</h2>
{% if snapshot.recent_jobs %}
<div class="table-wrap">
<table class="recent-jobs">
  <thead><tr><th scope="col">Type</th><th scope="col">Target</th><th scope="col">Status</th><th scope="col" class="numeric">Duration</th><th scope="col">Actor</th><th scope="col">Finished</th><th scope="col">Details</th></tr></thead>
  <tbody>
  {% for job in snapshot.recent_jobs %}
  <tr class="job{% if job.status == 'failed' %} job-failed row-attention{% endif %}" data-job-id="{{ job.id }}">
    <td>{{ job.type }}</td><td>{{ job.summary or "—" }}</td>
    <td><span class="badge {{ 'badge-danger' if job.status == 'failed' else 'badge-ok' if job.status == 'succeeded' else 'badge-info' }}">{{ icon('danger' if job.status == 'failed' else 'ok' if job.status == 'succeeded' else 'info') }} {{ job.status }}</span></td>
    <td class="numeric">{% if job.duration_seconds is not none %}{{ job.duration_seconds // 60 }}m {{ job.duration_seconds % 60 }}s{% else %}—{% endif %}</td>
    <td>{{ job.actor }}</td><td>{{ time_tag(job.finished_at, tz) }}</td><td><a href="{{ job.href }}" aria-label="Details for {{ job.type }} job">Details</a></td>
  </tr>
  {% endfor %}
  </tbody>
</table>
</div>
{% else %}
<section class="empty-state"><h3>No jobs have run yet</h3><p>Discovery, scan and deployment results will appear here after work runs.</p><a href="/scans">Review scan endpoints</a></section>
{% endif %}
{% endblock %}
{% block unknown_certificates %}
{% if unknown %}
<h2>Unknown certificates on servers</h2>
<div class="table-wrap">
<table class="unknown-bindings">
  <thead><tr><th scope="col">Server</th><th scope="col">Virtual host</th><th scope="col">On-disk fingerprint</th><th scope="col">Action</th></tr></thead>
  <tbody>
  {% for b in unknown %}
  <tr data-binding-id="{{ b.id }}">
    <td><a href="/servers/{{ b.server_id }}">{{ b.server }}</a></td><td>{{ b.vhost_name }}:<span class="mono">{{ b.port }}</span></td>
    <td>{% if b.on_disk_fingerprint %}<code>{{ b.on_disk_fingerprint }}</code>{% else %}—{% endif %}</td>
    <td><a href="/certificates/import?from_binding={{ b.id }}">Import as certificate</a></td>
  </tr>
  {% endfor %}
  </tbody>
</table>
</div>
<p class="hint">The newest <span class="mono">{{ unknown | length }}</span> unknown bindings; <a href="/bindings?match_state=unknown">see all</a>.</p>
{% endif %}
{% endblock %}
{% block renewals_in_flight %}
<h2>Renewals in flight</h2>
{% if snapshot.renewals %}
<ul class="renewals-in-flight plain">
  {% for renewal in snapshot.renewals %}
  <li data-renewal-id="{{ renewal.id }}"><a href="/renewals/{{ renewal.id }}">{{ renewal.common_name }}</a> <span class="badge badge-info">{{ icon('info') }} {{ renewal.state }}</span> · <span class="mono">{{ renewal.age_days }} day{{ "" if renewal.age_days == 1 else "s" }}</span> in this state</li>
  {% endfor %}
</ul>
{% else %}
<section class="empty-state"><h3>No renewals in flight</h3><p>Open renewal requests appear here, oldest state first.</p><a href="/certificates">Review certificates for renewal</a></section>
{% endif %}
{% endblock %}
</details>
{% endblock %}
