{% extends "base.html.j2" %}
{% block title %}{{ row.host }} · Scans · Cert Dashboard{% endblock %}
{% block extra_css %}{% from "_inventory_ui.html.j2" import enhanced_forms %}{{ enhanced_forms() }}<link rel="stylesheet" href="/static/pages/scans.css">{% endblock %}
{% block content %}
{% from "_inventory_ui.html.j2" import scan_state, identifier %}
<p><a href="/scans">← All scans</a></p>
<h1>{{ hostport(row.host, row.port) }}</h1>
<section class="panel wide" id="endpoint-panel" aria-label="Endpoint">
  <p>{{ scan_state(row.status) }}
    {% if not row.is_active %}<small>Inactive: scheduled scans skip this endpoint.</small>{% endif %}</p>
  {% if row.status == 'ok' %}<p>No expiry or certificate-mismatch findings in this scan. This is not a complete TLS security audit.</p>
  {% elif row.status in ['unreachable', 'error'] %}<p>The scan did not complete. Do not interpret missing observations as a healthy endpoint. Check connectivity and the error below, then scan again.</p>
  {% elif row.status in ['expired', 'mismatch'] %}<p>Action required: {{ 'the served certificate has expired' if row.status == 'expired' else 'the served certificate differs from the inventory expectation' }}.</p>
  {% else %}<p>No scan result is available. Run a scan to establish the endpoint state.</p>{% endif %}
  {% if row.error %}<p class="form-error" data-field="scan_error">{{ row.error }}</p>{% endif %}
  <dl class="fields">
    <dt>SNI</dt><dd>{{ row.sni or "— (the host name is sent)" }}</dd>
    <dt>Source</dt><dd>{{ row.source }}</dd>
    <dt>Server</dt><dd>{{ row.server or "—" }}</dd>
    <dt>Expected certificate</dt><dd>{% if row.expected_certificate_id %}<a href="/certificates/{{ row.expected_certificate_id }}">{{ row.expected_common_name }}</a> {{ identifier(row.expected_fingerprint) }}{% else %}none{% endif %}</dd>
    <dt>Last checked</dt><dd>{{ time_tag(row.checked_at, tz) }}</dd>
    <dt>Observed common name</dt><dd>{{ row.observed_common_name or "—" }}</dd>
    <dt>Observed issuer</dt><dd>{{ row.observed_issuer_cn or "—" }}</dd>
    <dt>Observed expiry</dt><dd>{{ time_tag(row.observed_not_after, tz) }}</dd>
    <dt>Observed fingerprint</dt><dd>{% if row.observed_fingerprint %}{{ identifier(row.observed_fingerprint) }}{% else %}—{% endif %}</dd>
    <dt>Chain length / TLS</dt><dd class="mono">{{ row.observed_chain_length or "—" }} / {{ row.tls_version or "—" }}</dd>
  </dl>
  {% if scan_supported and row.is_active %}<form class="inline" method="post" action="/scans/run">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    <input type="hidden" name="scope" value="endpoint">
    <input type="hidden" name="endpoint_id" value="{{ row.id }}">
    <button type="submit">Scan now</button>
  </form>
  {% else %}<button type="button" disabled title="{{ scan_reason or 'Inactive endpoints are not scanned' }}">Scan now</button>{% endif %}
</section>

{% block manage %}
<section class="panel wide" id="manage-panel" aria-label="Manage endpoint">
  <h2>Manage</h2>
  <h3 id="expectation-form">Expected certificate</h3>
  <p class="hint">Update the expectation when the virtual host was changed on purpose. Earlier scan results keep the certificate that was expected when they ran.</p>
  {% if errors.certificate_id %}<div class="form-error" data-error="certificate_id" role="alert"><p>{{ errors.certificate_id }}{% if offer_import %} <a href="{{ import_url }}">Import the served certificate</a> first.{% endif %}</p></div>{% endif %}
  <form method="post" action="/scans/{{ row.id }}/expectation" hx-post="/scans/{{ row.id }}/expectation" hx-target="#manage-panel" hx-swap="outerHTML">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    <label for="expect_certificate">Active certificate</label>
    <select id="expect_certificate" name="certificate_id" required>
      {% set chosen = form_certificate or (row.expected_certificate_id | string) %}
      <option value="">Choose…</option>
      {% for id, name, not_after in certificates %}<option value="{{ id }}"{% if chosen == id | string %} selected{% endif %}>{{ name }} (#{{ id }}, expires {{ not_after.date() }})</option>{% endfor %}
    </select>
    <button type="submit">Set expectation</button>
  </form>
  {% if row.observed_fingerprint %}
  {% if detail.observed_certificate_active %}
  <form method="post" action="/scans/{{ row.id }}/expectation" hx-post="/scans/{{ row.id }}/expectation" hx-target="#manage-panel" hx-swap="outerHTML">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    <input type="hidden" name="use_observed" value="1">
    <button type="submit">Use the observed certificate</button>
  </form>
  {% elif detail.observed_certificate_id %}
  <p class="hint">The observed certificate is <a href="/certificates/{{ detail.observed_certificate_id }}">in the inventory but is not active</a> (revoked or superseded), so it cannot be expected. Choose an active certificate above.</p>
  {% else %}
  <p class="hint">The observed certificate is not in the inventory: <a href="{{ import_url }}">import the served certificate</a> first.</p>
  {% endif %}
  {% endif %}
  <h3>Scheduled scans</h3>
  {% if errors.active %}<div class="form-error" data-error="active" role="alert"><p>{{ errors.active }}</p></div>{% endif %}
  <form method="post" action="/scans/{{ row.id }}/active" hx-post="/scans/{{ row.id }}/active" hx-target="#manage-panel" hx-swap="outerHTML">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    <input type="hidden" name="active" value="{{ 'false' if row.is_active else 'true' }}">
    <button type="submit">{{ "Deactivate" if row.is_active else "Activate" }}</button>
    <small>Endpoints are never deleted; deactivating keeps the history.</small>
  </form>
</section>
{% endblock %}

{% if row.status == "mismatch" %}
<section class="panel wide" id="mismatch" aria-label="Mismatch">
  <h2>This endpoint serves a different certificate than expected</h2>
  <p>Expected: {% if row.expected_certificate_id %}<a href="/certificates/{{ row.expected_certificate_id }}">{{ row.expected_common_name }}</a> {{ identifier(row.expected_fingerprint) }}{% else %}no certificate is expected for this endpoint{% endif %}</p>
  <p>Served: {% if detail.observed_certificate_id %}<a href="/certificates/{{ detail.observed_certificate_id }}">{{ row.observed_common_name }}</a>{% else %}{{ row.observed_common_name or "an unknown certificate" }} (not in the inventory){% endif %} {{ identifier(row.observed_fingerprint) }}</p>
  <h3>Likely actions</h3>
  <ul>
    {% if row.expected_certificate_id %}<li>The old certificate is still being served: <a href="/renewals/new?from={{ row.expected_certificate_id }}">Renew and deploy</a> the expected certificate.</li>{% endif %}
    {% if detail.observed_certificate_active %}
    <li id="expectation">If the virtual host changed on purpose, update the expectation to the certificate it now serves: <a href="#manage-panel">use the observed certificate</a>.</li>
    {% elif detail.observed_certificate_id %}
    <li id="expectation">The served certificate is in the inventory but is not active (revoked or superseded), so it cannot be expected. Choose an active certificate in the endpoint settings, or renew and deploy a new one.</li>
    {% else %}
    <li id="expectation"><a href="{{ import_url }}">Import the served certificate</a> from this endpoint (host, port and SNI are prefilled); if the virtual host changed on purpose, you can then use it as the expectation.</li>
    {% endif %}
  </ul>
</section>
{% endif %}

<section class="panel wide" id="history" aria-label="History">
{% block history %}
{% from "_inventory_ui.html.j2" import scan_state, identifier %}
  <h2>History</h2>
  <p class="hint">The last {{ detail.history | length }} result{{ "" if detail.history | length == 1 else "s" }} (newest first) for {{ hostport(detail.row.host, detail.row.port) }}.</p>
  {% if detail.history %}
  <div class="table-wrap"><table>
    <thead><tr><th scope="col">Checked</th><th scope="col">Status</th><th scope="col">Observed fingerprint</th><th scope="col">Common name</th><th scope="col">Source</th><th scope="col">Error</th></tr></thead>
    <tbody>
    {% for item in detail.history %}
    <tr class="scan-history-row">
      <td>{{ time_tag(item.checked_at, tz) }}</td>
      <td>{{ scan_state(item.status.value) }}</td>
      <td>{% if item.observed_fingerprint %}{{ identifier(item.observed_fingerprint) }}{% else %}—{% endif %}</td>
      <td>{{ item.observed_common_name or "—" }}</td>
      <td>{{ item.source }}</td>
      <td>{{ item.error or "" }}</td>
    </tr>
    {% endfor %}
    </tbody>
  </table></div>
  {% else %}<p>This endpoint has not been scanned yet.</p>{% endif %}
{% endblock %}
</section>
{% endblock %}
