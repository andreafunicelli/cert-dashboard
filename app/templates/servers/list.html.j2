{% extends "base.html.j2" %}
{% block title %}Servers · Cert Dashboard{% endblock %}
{% block content %}
<h1>Servers</h1>
<section class="panel wide" aria-label="Filters">
  <form method="get" action="/servers" class="filters">
    <label>Search <input type="search" name="search" value="{{ values.search or '' }}" maxlength="200" placeholder="Host name"></label>
    <label>Group <input name="group" value="{{ values.group or '' }}" maxlength="200"></label>
    <label>Servers
      <select name="active">
        <option value="true"{% if not values.active %} selected{% endif %}>Active</option>
        <option value="false"{% if values.active == "false" %} selected{% endif %}>Inactive</option>
        <option value="all"{% if values.active == "all" %} selected{% endif %}>All</option>
      </select></label>
    <input type="hidden" name="sort" value="{{ sort_state }}">
    <input type="hidden" name="page_size" value="{{ page.page_size }}">
    <button type="submit">Apply filters</button>
    <a href="/servers">Reset</a>
  </form>
</section>

<div class="list-summary" data-total="{{ page.total }}">{{ page.total }} server{{ "" if page.total == 1 else "s" }}
  · <a href="{{ export_url }}" download="servers.json">Export list as JSON</a>
  · <a href="/bindings">Where is a certificate used?</a></div>

{% if page.items %}
<div class="table-wrap">
<table class="servers">
  <thead><tr>
    <th scope="col"><a href="{{ sort_url('hostname') }}">Server</a></th>
    <th scope="col">Groups</th>
    <th scope="col">Web server</th>
    <th scope="col"><a href="{{ sort_url('binding_count') }}">Bindings</a></th>
    <th scope="col"><a href="{{ sort_url('last_discovery_at') }}">Last discovery</a></th>
    <th scope="col"><a href="{{ sort_url('mismatch_count') }}">Mismatched endpoints</a></th>
  </tr></thead>
  <tbody>
  {% for row in page.items %}
  <tr data-server-id="{{ row.id }}"{% if not row.is_active %} class="row-inactive"{% endif %}>
    <td><a href="/servers/{{ row.id }}">{{ row.hostname }}</a>{% if row.display_name %}<br><small>{{ row.display_name }}</small>{% endif %}{% if not row.is_active %} <small>(inactive)</small>{% endif %}</td>
    <td>{{ row.groups | join(", ") or "—" }}</td>
    <td>{{ row.webserver or "—" }}</td>
    <td>{{ row.binding_count }}{% if row.attention_count %} <span class="chip chip-critical" title="Bindings with a key mismatch or a missing file">{{ row.attention_count }} need attention</span>{% endif %}</td>
    <td>{% if row.last_discovery_at %}{{ time_tag(row.last_discovery_at, tz) }}<br><span class="chip chip-{{ 'ok' if row.last_discovery_status == 'ok' else 'warning' }}">{{ row.last_discovery_status or "unknown" }}</span>{% else %}<em>never</em>{% endif %}</td>
    <td>{% if row.mismatch_count %}<a href="/scans?server_id={{ row.id }}&amp;status=mismatch">{{ row.mismatch_count }}</a>{% else %}0{% endif %}</td>
  </tr>
  {% endfor %}
  </tbody>
</table>
</div>
{% else %}
<p class="panel wide">No servers match these filters. <a href="/servers">Clear the filters</a>. Servers appear once discovery has run (a later plan).</p>
{% endif %}

<nav class="pager" aria-label="Pages">
  {% if page.page > 1 %}<a rel="prev" href="{{ page_url(page.page - 1) }}">Previous</a>{% endif %}
  <span>Page {{ page.page }} of {{ pages }}</span>
  {% if page.page < pages %}<a rel="next" href="{{ page_url(page.page + 1) }}">Next</a>{% endif %}
</nav>
{% endblock %}
