{% extends "base.html.j2" %}
{% block title %}Servers · Cert Dashboard{% endblock %}
{% block extra_css %}<link rel="stylesheet" href="/static/pages/servers.css">{% endblock %}
{% from "bindings/_presentation.html.j2" import discovery_state %}
{% from "_ui.html.j2" import icon %}
{% block content %}
{% from "_operations_ui.html.j2" import page_header, more_actions, filters %}
{% call page_header('Servers', 'Find hosts, stored bindings and discovery failures before checking live TLS drift.') %}
  {% if discovery_reason %}<button type="button" disabled title="{{ discovery_reason }}">Run discovery</button>
  {% else %}<a class="button" href="#discovery-actions">Run discovery</a>{% endif %}
  {% call more_actions() %}<a href="/inventory">Manage inventory</a><a href="{{ export_url }}" download="servers.json">Export list as JSON</a><a href="/bindings">Where is a certificate used?</a>{% endcall %}
{% endcall %}
{% call filters('/servers', values, {'search': 'Search', 'group': 'Group', 'active': 'Servers'}, 'search', 'Host name') %}
  <label>Group <input name="group" value="{{ values.group or '' }}" maxlength="200"></label>
  <label>Servers <select name="active">
    <option value="true"{% if not values.active %} selected{% endif %}>Active</option>
    <option value="false"{% if values.active == "false" %} selected{% endif %}>Inactive</option>
    <option value="all"{% if values.active == "all" %} selected{% endif %}>All</option>
  </select></label>
  <input type="hidden" name="sort" value="{{ sort_state }}">
  <input type="hidden" name="page_size" value="{{ page.page_size }}">
{% endcall %}
<div class="list-summary" data-total="{{ page.total }}"><span class="mono">{{ page.total }}</span> server{{ "" if page.total == 1 else "s" }} · Last seen means the recorded discovery time, not a live reachability check.</div>
{% if page.items %}
<div class="table-wrap" role="region" tabindex="0" aria-label="Server results">
<table class="servers verdict-list">
  <thead><tr>
    <th scope="col"><a href="{{ sort_url('hostname') }}">Server</a></th>
    <th scope="col">Groups</th>
    <th scope="col">Discovery state</th>
    <th scope="col" class="numeric"><a href="{{ sort_url('binding_count') }}">Bindings</a></th>
    <th scope="col" class="numeric"><a href="{{ sort_url('last_discovery_at') }}">Last seen / discovery</a></th>
    <th scope="col" class="numeric"><a href="{{ sort_url('mismatch_count') }}">TLS drift</a></th>
  </tr></thead>
  <tbody>
  {% for row in page.items %}
  <tr data-server-id="{{ row.id }}"{% if not row.is_active %} class="row-inactive"{% endif %}>
    <td><a class="row-identity" href="/servers/{{ row.id }}" title="{{ row.hostname }}">{{ row.hostname }}</a><small class="row-secondary" title="{{ row.display_name or '' }}">{{ row.display_name or row.webserver or 'Web server unknown' }}{% if not row.is_active %} (inactive){% endif %}</small></td>
    <td title="{{ row.groups | join(', ') }}"><span class="row-identity">{{ row.groups | join(", ") or "—" }}</span></td>
    <td>{{ discovery_state(row.last_discovery_status, row.last_discovery_at) }}{% if row.last_discovery_status in ('failed', 'unreachable', 'error') %}<a class="row-secondary" href="/servers/{{ row.id }}#server-panel">View host failure reason</a>{% endif %}</td>
    <td class="numeric">{{ row.binding_count }}{% if row.attention_count %}<p><span class="badge badge-warn" title="Bindings with a key mismatch or a missing file">{{ icon('warn') }}{{ row.attention_count }} issues</span></p>{% endif %}</td>
    <td class="numeric">{% if row.last_discovery_at %}<p>{{ time_tag(row.last_discovery_at, tz) }}</p>{% elif row.last_discovery_status %}Time not recorded{% else %}Never discovered{% endif %}</td>
    <td class="numeric">{% if row.mismatch_count %}<a href="/scans?server_id={{ row.id }}&amp;status=mismatch"><span class="badge badge-warn">{{ icon('warn') }}{{ row.mismatch_count }} drifted</span></a>{% else %}0{% endif %}</td>
  </tr>
  {% endfor %}
  </tbody>
</table>
</div>
{% else %}
<section class="empty-state"><h2>No servers match these filters</h2><p><a href="/servers">Clear the filters</a>. Servers appear once discovery has run: use “Discover all” below.</p></section>
{% endif %}
<nav class="pager" aria-label="Pages">
  {% if page.page > 1 %}<a rel="prev" href="{{ page_url(page.page - 1) }}">Previous</a>{% endif %}
  <span>Page <span class="mono">{{ page.page }}</span> of <span class="mono">{{ pages }}</span></span>
  {% if page.page < pages %}<a rel="next" href="{{ page_url(page.page + 1) }}">Next</a>{% endif %}
</nav>
<section class="panel wide" id="discovery-actions" aria-label="Discovery">
  <h2>Discovery</h2>
  <p class="help">Run across the inventory or a group. Open a server for failure reasons, captured results and run history; this list does not receive host error details.</p>
  {% if discovery_reason %}
  <button class="button-secondary" type="button" disabled title="{{ discovery_reason }}">Discover all</button>
  <button class="button-secondary" type="button" disabled title="{{ discovery_reason }}">Discover group</button>
  <p class="hint">{{ discovery_reason }}</p>
  {% else %}
  <form class="inline" method="post" action="/servers/discover">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    <input type="hidden" name="scope" value="all">
    <button class="button-secondary" type="submit">Discover all</button>
  </form>
  {% if groups %}
  <form class="inline" method="post" action="/servers/discover">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    <input type="hidden" name="scope" value="group">
    <label>Group <select name="group">
      {% for name in groups %}<option value="{{ name }}"{% if name == values.group %} selected{% endif %}>{{ name }}</option>{% endfor %}
    </select></label>
    <button class="button-secondary" type="submit">Discover group</button>
  </form>
  {% else %}<button class="button-secondary" type="button" disabled title="No server has an inventory group yet">Discover group</button>{% endif %}
  {% endif %}
</section>
{% endblock %}
