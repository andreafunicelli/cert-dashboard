{% extends "base.html.j2" %}
{% block title %}Settings · Cert Dashboard{% endblock %}
{% block extra_css %}<link rel="stylesheet" href="/static/pages/settings.css">{% if tab == 'smtp' or tab == 'alerts' %}<link rel="stylesheet" href="/static/pages/email.css">{% endif %}{% from "_inventory_ui.html.j2" import enhanced_forms %}{{ enhanced_forms() }}{% endblock %}
{% block content %}
<h1>Settings</h1>
<p class="help">Save each section explicitly. Without JavaScript, unsaved changes are lost when switching tabs. With JavaScript, non-secret configuration drafts stay in this browser tab until saved. Secrets and repository URLs are never retained; save repository URL edits before switching tabs.</p>
<nav class="tabs" aria-label="Settings sections">
  <ul>
  {% for item in tabs %}
    <li><a href="/settings?tab={{ item.name }}"{% if item.name == tab %} aria-current="page"{% endif %}>{{ item.label }}<span class="field-change" data-settings-tab-draft="{{ item.name }}" hidden> (unsaved draft)</span></a></li>
  {% endfor %}
  </ul>
</nav>
{% block panel %}
{% from "_ui.html.j2" import icon %}
{% macro disabled_action(label, reason) %}<p class="action-disabled"><button type="button" disabled aria-disabled="true">{{ label }}</button> <span class="hint">{{ reason }}</span></p>{% endmacro %}
{% set draft_saved = saved or (tab == 'trust' and ('Public CA bundle included.' in (flash | default([])) or 'Public CA bundle excluded.' in (flash | default([])))) %}
<section class="panel wide" id="settings-panel" data-tab="{{ tab }}" data-settings-saved="{{ 'true' if draft_saved else 'false' }}" data-settings-errors="{{ 'true' if errors else 'false' }}" aria-labelledby="tab-heading">
  <h2 id="tab-heading">{{ tab_label }}</h2>
  <p id="settings-draft-status" role="status" class="help">No unsaved draft restored. Changes are not applied until you save.</p>
  {% if saved %}<p class="notice" role="status">Settings saved.</p>{% endif %}
  {% if errors.get("form") %}<div class="form-error" data-field="form" role="alert">{% for message in errors["form"] %}<p>{{ message }}</p>{% endfor %}</div>{% endif %}
  {% if tab == "trust" %}
  <p data-public-bundle>Public bundle: certifi {{ bundle.version }}, {{ bundle.roots }} roots, include-public-bundle = {{ "true" if bundle.enabled else "false" }}</p>
  <p class="hint">The public roots are read-only, in-memory entries of the pinned certifi bundle; they are never listed or stored as rows.</p>
  <form data-settings-draft method="post" action="/settings/trust">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    <div class="settings-field">
    <input type="hidden" name="include_public_bundle" value="false">
    <label for="f-include-public-bundle" class="checkbox"><input type="checkbox" id="f-include-public-bundle" name="include_public_bundle" value="true"{% if bundle.enabled %} checked{% endif %}> Trust the public CA bundle</label>
    <span class="field-change" hidden>Unsaved change</span>
    </div>
    <p class="help">Disabling this removes public CA roots from chain verification. Certificates relying on those roots may become untrusted.</p>
    <p class="hint">Saving rechecks the stored chain statuses immediately.</p>
    <button type="submit">Save and recheck</button>
  </form>

  <h3>Uploaded trust anchors</h3>
  {% if disabled.trust_recheck %}{{ disabled_action("Recheck now", disabled.trust_recheck) }}{% else %}
  <form method="post" action="/settings/trust-anchors/recheck">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    <p class="hint">Also runs daily with the scan. Chain statuses are rechecked against the current time in the background.</p>
    <button type="submit">Recheck now</button>
  </form>
  {% endif %}
  {% if anchors %}
  <div class="table-wrap"><table>
    <thead><tr><th>Subject</th><th>SHA-256 fingerprint</th><th>Source</th><th>Notes</th><th>Added</th><th>Added by</th><th>Remove</th></tr></thead>
    <tbody>
    {% for a in anchors %}
      <tr data-anchor="{{ a.id }}">
        <td>{{ a.subject }}</td>
        <td><code>{{ a.fingerprint }}</code></td>
        <td>{{ a.source }}</td>
        <td>{{ a.notes }}</td>
        <td>{{ time_tag(a.created_at, timezone) }}</td>
        <td>{{ a.created_by }}</td>
        <td>
          <form method="post" action="/settings/trust-anchors/{{ a.id }}/delete">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
            <label for="f-delete-{{ a.id }}">Type DELETE to confirm</label>
            <input id="f-delete-{{ a.id }}" name="confirm" autocomplete="off" required>
            <p class="help">Removes this root and rechecks stored chains. Certificates that depend on it may become untrusted.</p>
            <button type="submit" class="button-destructive">Delete</button>
          </form>
        </td>
      </tr>
    {% endfor %}
    </tbody>
  </table></div>
  {% else %}
  <p>No uploaded trust anchors.</p>
  {% endif %}

  <h3>Add an internal root</h3>
  <p class="help">Trust-anchor upload fields are not kept as drafts. Add the anchor before leaving this page; file selections, pasted PEM and notes are lost on navigation.</p>
  <form method="post" action="/settings/trust-anchors" enctype="multipart/form-data">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    <label for="f-anchor-file">PEM file</label>
    <input type="file" id="f-anchor-file" name="file" accept=".pem,.crt,.cer">
    <label for="f-anchor-pem">or paste one PEM certificate</label>
    <textarea id="f-anchor-pem" name="pem" rows="6" autocomplete="off"></textarea>
    <p class="hint">One self-signed CA root (CA:TRUE, certificate-signing key usage), at most 1,048,576 bytes. Saving rechecks the stored chain statuses immediately.</p>
    <label for="f-anchor-notes">Notes</label>
    <input id="f-anchor-notes" name="notes" maxlength="{{ max_notes }}" autocomplete="off">
    <button type="submit">Add trust anchor</button>
  </form>
  {% elif tab == "status" %}
  {% set k = snapshot.keyring %}{% set w = snapshot.worker %}{% set q = snapshot.queue %}
  <h3>Warnings</h3>
  {% if snapshot.warnings %}
  <ul class="warnings">{% for code in snapshot.warnings %}<li data-warning="{{ code }}">{{ warning_text[code] }}</li>{% endfor %}</ul>
  {% else %}<p>No warnings.</p>{% endif %}

  <h3>Worker</h3>
  <ul>
    <li>State: <strong data-worker-state="{{ w.state }}">{{ w.state }}</strong></li>
    <li>Last heartbeat: {{ time_tag(when(w.last_seen_at), timezone) }}</li>
    <li>Heartbeat every {{ w.heartbeat_interval_seconds }} seconds; stale after {{ w.stale_after_seconds // 60 }} minutes</li>
    <li>Live workers: {{ w.workers }}</li>
  </ul>

  <h3>Queue</h3>
  <ul>
    <li>Queued {{ q.queued }}</li>
    <li>Running {{ q.running }}</li>
    <li>Paused {{ q.paused }}</li>
    <li>Failed in the last 24 hours {{ q.failed_24h }}</li>
  </ul>

  {% set s = snapshot.smtp %}
  <h3>SMTP delivery</h3>
  <ul data-smtp-health>
    {% if s.consecutive_failures %}
    <li><strong>{{ s.consecutive_failures }} consecutive delivery failure{{ "" if s.consecutive_failures == 1 else "s" }}</strong>; last error: <code>{{ s.last_error or "unknown" }}</code></li>
    {% else %}<li>No delivery failures since the last successful delivery.</li>{% endif %}
    <li>Last successful delivery: {% if s.last_success_at %}{{ time_tag(when(s.last_success_at), timezone) }}{% else %}never{% endif %}</li>
    <li>Last test e-mail: {% if s.last_test %}{{ s.last_test.status }}, {{ time_tag(when(s.last_test.finished_at or s.last_test.requested_at), timezone) }}{% else %}none yet{% endif %}</li>
  </ul>
  <p><a href="/settings?tab=smtp">Send a test email</a> from the SMTP tab to check the connection.</p>

  <h3>Keyring</h3>
  <ul>
    <li>Active version {{ k.active_version }}</li>
    <li>Loaded versions: {{ k.loaded_versions | join(", ") }}</li>
    <li>File SHA-256: <code>{{ k.file_sha256 or "unknown" }}</code></li>
    <li>Versions referenced by stored keys but missing from the keyring: {{ k.missing_versions | join(", ") or "none" }}</li>
    <li>Rows not yet on the active version: {{ k.stale_rows }}</li>
  </ul>

  <h3>Database</h3>
  <p>Database size: {{ db_size }}</p>

  <h3>Last runs</h3>
  {% if snapshot.last_runs %}
  <div class="table-wrap"><table>
    <thead><tr><th>Schedule</th><th>Last run</th></tr></thead>
    <tbody>{% for key, value in snapshot.last_runs.items() %}<tr><td>{{ key }}</td><td>{{ time_tag(when(value), timezone) }}</td></tr>{% endfor %}</tbody>
  </table></div>
  {% else %}<p>No scheduled run has been recorded yet.</p>{% endif %}
  {% if snapshot.last_jobs %}
  <div class="table-wrap"><table>
    <thead><tr><th>Job type</th><th>Last finished job</th><th>Finished</th></tr></thead>
    <tbody>{% for key, value in snapshot.last_jobs.items() %}<tr><td>{{ key }}</td><td>{{ value.status }}</td><td>{{ time_tag(when(value.finished_at), timezone) }}</td></tr>{% endfor %}</tbody>
  </table></div>
  {% else %}<p>No job has finished yet.</p>{% endif %}
  {% elif tab == "maintenance" %}
  {% set k = snapshot.keyring %}
  <h3>Master key rotation</h3>
  <p>Rotation is a command-line operation; this page never edits the keyring or rotates keys. Current state:</p>
  <ul>
    <li>Active version {{ k.active_version }}; loaded versions: {{ k.loaded_versions | join(", ") }}</li>
    <li>Rows not yet on the active version: {{ k.stale_rows }}</li>
    <li>Versions referenced by stored keys but missing from the keyring: {{ k.missing_versions | join(", ") or "none" }}</li>
  </ul>
  <p>Run these on the dashboard host as root (full procedure: <code>docs/operations.md</code>, section 6). Take a database backup first.</p>
  <ol>
    <li>Generate the next version into a <strong>new</strong> file in a temporary <code>0700</code> directory owned by the container user, merging the current keyring (live limit: two versions). The current <code>master_key</code> is mounted read-only at <code>/secrets</code> and the new file is written to <code>/out</code>; both paths exist only inside this one <code>docker run</code>:
      <pre><code>set -eu
tmp="$(mktemp -d /tmp/cert-dashboard-keyring.XXXXXXXX)"
install -d -m 0700 -o 10001 -g 10001 "$tmp"
docker run --rm -v /etc/cert-dashboard/secrets:/secrets:ro -v "$tmp":/out cert-dashboard:local \
  python -m app.cli generate-master-key --version {{ next_version }} --merge /secrets/master_key --output /out/master_key.v{{ next_version }}.new
sha256sum "$tmp/master_key.v{{ next_version }}.new"</code></pre>
      The command prints only <code>sha256=&lt;digest&gt; path=&lt;file&gt;</code>; the digest must equal the <code>sha256sum</code> output.</li>
    <li>Keep a copy of the old file in the backup location, install the verified file as the <code>master_key</code> secret and restart so new writes use it:
      <pre><code>install -m 0400 -o 10001 -g 10001 "$tmp/master_key.v{{ next_version }}.new" /etc/cert-dashboard/secrets/master_key
shred -u -- "$tmp/master_key.v{{ next_version }}.new" &amp;&amp; rmdir -- "$tmp"
docker compose up -d --force-recreate web worker</code></pre></li>
    <li>Re-encrypt every key and TOTP seed (batched, idempotent, resumable):
      <pre><code>docker compose run --rm web python -m app.cli rotate-master-key</code></pre></li>
    <li>Verify a keyed certificate (metadata only is printed):
      <pre><code>docker compose run --rm web python -m app.cli verify-key --certificate-id ID</code></pre></li>
  </ol>
  <p class="hint">Secret files are read once at startup: replace the file, rerun <code>scripts/install-secrets.sh</code> and restart the service.</p>

  <h3>Prune old jobs</h3>
  <p>Queues the retention cleanup now: finished jobs older than the retention period, old scan results, expired sessions and old artifacts are removed. Audit rows are never removed.</p>
  <form method="post" action="/settings/maintenance/prune">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    <label for="f-prune-confirm">Type {{ prune_confirmation }} to confirm</label>
    <input id="f-prune-confirm" name="confirm" autocomplete="off" required>
    <button type="submit" class="button-destructive">Queue retention cleanup</button>
  </form>
  {% else %}
  {% if tab == 'smtp' %}<p><a href="#smtp-test-result">Delivery outcome: {{ smtp_test.status if smtp_test else 'not tested' }}</a>. Test send uses saved SMTP settings, not unsaved edits.</p>{% endif %}
  <form class="settings-form" data-settings-draft method="post" action="/settings/{{ tab }}" hx-post="/settings/{{ tab }}" hx-target="#settings-panel" hx-swap="outerHTML" hx-select="#settings-panel">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    {% for f in fields %}
    <div class="settings-field">
      {% if f.widget == "checkbox" %}
    <input type="hidden" name="{{ f.name }}" value="false">
    <label for="f-{{ f.name }}" class="checkbox"><input type="checkbox" id="f-{{ f.name }}" name="{{ f.name }}" value="true"{% if values[f.name] %} checked{% endif %}> {{ f.label }}</label>
      {% elif f.widget == "select" %}
    <label for="f-{{ f.name }}">{{ f.label }}</label>
    <select id="f-{{ f.name }}" name="{{ f.name }}">
      {% for option, text in f.choices %}<option value="{{ option }}"{% if values[f.name] == option %} selected{% endif %}>{{ text }}</option>{% endfor %}
    </select>
      {% elif f.widget == "textarea" %}
    <label for="f-{{ f.name }}">{{ f.label }}</label>
    <textarea id="f-{{ f.name }}" name="{{ f.name }}" rows="6" maxlength="20000">{{ values[f.name] }}</textarea>
      {% else %}
    <label for="f-{{ f.name }}">{{ f.label }}</label>
    <input id="f-{{ f.name }}" name="{{ f.name }}" value="{{ values[f.name] }}" maxlength="600" autocomplete="off"{% if f.placeholder %} placeholder="{{ f.placeholder }}"{% endif %}>
      {% endif %}
      <span class="field-change" hidden>Unsaved change</span>
      {% if f.hint %}<p class="hint">{{ f.hint }}</p>{% endif %}
      {% if f.name == 'tls_verify' %}<p class="warning-note">Disabling verification lets an impersonated SMTP server intercept mail credentials and content.</p>{% endif %}
      {% if f.name == 'pause_after_canary' %}<p class="help">If disabled, a successful canary proceeds without waiting for operator approval.</p>{% endif %}
      {% if f.name == 'cleanup_enabled' %}<p class="help">If disabled, old jobs, sessions and artifacts are not pruned by the scheduled cleanup.</p>{% endif %}
      {% if errors.get(f.name) %}<div class="form-error" data-field="{{ f.name }}" role="alert">{% for message in errors[f.name] %}<p>{{ f.label }} {{ message }}</p>{% endfor %}</div>{% endif %}
    </div>
    {% endfor %}
    <button type="submit">Save {{ tab_label }} settings</button>
  </form>
  {% if tab == "smtp" %}
  {% if tls_unsafe %}<p class="form-error" role="alert" data-warning="tls-verify">unsafe: TLS certificate verification disabled — mail credentials and content can be intercepted.</p>{% endif %}
  <p class="hint">SMTP password: provided only via the worker secret file <code>smtp_password</code>; not settable or visible here.</p>
  {% if disabled.get("test_email") %}{{ disabled_action("Send test email", disabled["test_email"]) }}
  {% else %}<form method="post" action="/settings/smtp/test"><input type="hidden" name="csrf_token" value="{{ csrf_token }}"><button type="submit">Send test email</button></form>{% endif %}
  {% block smtp_test_result %}
  {% from "_ui.html.j2" import icon %}
  {% if smtp_test %}{% set st = smtp_test %}
  <div id="smtp-test-result" data-test-status="{{ st.status }}"{% if st.status in ("queued", "running") %} hx-get="/settings/smtp/test/{{ st.job_id }}" hx-trigger="every 2s" hx-swap="outerHTML"{% endif %}>
    <h3>{{ icon('danger' if st.status == 'failed' else 'ok' if st.status == 'succeeded' else 'info') }} Last test e-mail</h3>
    {% if st.status == "succeeded" %}<p><strong>Delivered</strong>{% if st.recipient %} to {{ st.recipient }}{% endif %}, {{ time_tag(when(st.finished_at), timezone) }}</p>
    {% elif st.status == "failed" %}<p><strong>Failed</strong>, {{ time_tag(when(st.finished_at), timezone) }}</p>
    {% elif st.status in ("queued", "running") %}<p><strong>{{ st.status | capitalize }}</strong> since {{ time_tag(when(st.requested_at), timezone) }}; the worker has not finished it yet.</p>
    {% else %}<p><strong>{{ st.status | capitalize }}</strong></p>{% endif %}
    {% if st.steps %}<p>SMTP conversation (step and reply code only):</p>
    <ol class="smtp-steps">{% for s in st.steps %}<li>{{ s.step }}{% if s.code is not none %} {{ s.code }}{% endif %}</li>{% endfor %}</ol>{% endif %}
    {% if st.status == "failed" %}<p class="form-error" role="alert" data-field="smtp-test">{{ st.error_class }}: {{ st.error_message }}</p>{% endif %}
    <p class="help">This is the worker's recorded result, not an inbox receipt. A successful SMTP handoff does not guarantee inbox delivery. <a href="/settings?tab=smtp#smtp-test-result">Refresh result</a> if live updates are unavailable.</p>
  </div>
  {% else %}<p id="smtp-test-result">No test e-mail has been sent yet.</p>{% endif %}
  {% endblock %}
  {% elif tab == "alerts" %}
  <h3>Recent delivery failures</h3>
  {% if failures %}
  <div class="table-wrap"><table data-failures>
    <thead><tr><th>Kind</th><th>Certificate</th><th>Recipients</th><th>Attempts</th><th>Last attempt</th><th>Error</th></tr></thead>
    <tbody>
    {% for f in failures %}
      <tr data-notification="{{ f.id }}">
        <td>{{ f.kind }}{% if f.threshold_days is not none %} ({{ f.threshold_days }} days){% endif %}</td>
        <td>{% if f.certificate_id %}<a href="/certificates/{{ f.certificate_id }}">Certificate #{{ f.certificate_id }}</a>{% else %}—{% endif %}</td>
        <td>{{ f.recipients | join(", ") or "none" }}</td>
        <td>attempt {{ f.attempts }} of {{ max_attempts }}; {% if f.next_attempt_at %}next attempt {{ time_tag(f.next_attempt_at, timezone) }}{% else %}no further attempts{% endif %}</td>
        <td>{{ time_tag(f.last_attempt_at, timezone) }}</td>
        <td><code>{{ f.error or "unknown" }}</code></td>
      </tr>
    {% endfor %}
    </tbody>
  </table></div>
  {% else %}<p>No delivery failures.</p>{% endif %}
  {% elif tab == "inventory" %}
  <p id="inventory-revision" data-rev="{{ inventory.current_rev or '' }}">
    {% if inventory.current_rev %}Current revision: <code>{{ inventory.current_rev[:12] }}</code>{% if inventory.current_rev_date %}, committed {{ time_tag(when(inventory.current_rev_date), timezone) }}{% if timezone != "UTC" %} / {{ time_tag(when(inventory.current_rev_date), "UTC") }}{% endif %}{% endif %}{% if inventory.current_at %} (newest successful discovery, deploy or test pull, finished {{ time_tag(when(inventory.current_at), timezone) }}{% if timezone != "UTC" %} / {{ time_tag(when(inventory.current_at), "UTC") }}{% endif %}){% endif %}
    {% else %}Current revision: unknown (no discovery, deploy or test pull has succeeded yet).{% endif %}
  </p>
  {% if disabled.get("test_pull") %}{{ disabled_action("Test pull", disabled["test_pull"]) }}
  {% else %}<form method="post" action="/settings/inventory/test-pull"><input type="hidden" name="csrf_token" value="{{ csrf_token }}"><button type="submit">Test pull</button></form>
  {% if not inventory.worker.reporting %}<p class="hint">No worker has reported its capabilities recently; a test pull waits in the queue until one picks it up.</p>{% endif %}{% endif %}
  <p class="hint">Test pull fetches the repository and lists the hosts and groups on the worker; it does not connect to any server.</p>
  {% block test_pull_result %}
  {% macro both(value, tz) %}{{ time_tag(value, tz) }}{% if tz != "UTC" %} / {{ time_tag(value, "UTC") }}{% endif %}{% endmacro %}
  {% if test_pull %}{% set tp = test_pull %}
  <div id="test-pull-result" data-test-status="{{ tp.status }}"{% if tp.status in ("queued", "running") %} hx-get="/settings/inventory/test-pull/{{ tp.job_id }}" hx-trigger="every 2s" hx-swap="outerHTML"{% endif %}>
    <h3>Last test pull</h3>
    {% if tp.status == "succeeded" %}<p><strong>Succeeded</strong>, finished {{ both(when(tp.finished_at), timezone) }}</p>
    {% elif tp.status == "failed" %}<p><strong>Failed</strong>, {{ both(when(tp.finished_at), timezone) }}</p>
    {% elif tp.status in ("queued", "running") %}<p><strong>{{ tp.status | capitalize }}</strong> since {{ both(when(tp.requested_at), timezone) }}; the worker has not finished it yet.</p>
    {% else %}<p><strong>{{ tp.status | capitalize }}</strong></p>{% endif %}
    {% if tp.result %}{% set r = tp.result %}
    <p>Revision <code>{{ r.rev[:12] }}</code>{% if r.rev_date %}, committed {{ both(when(r.rev_date), timezone) }}{% endif %}; {{ "the checkout was updated by this run" if r.refreshed else "the existing checkout was used (no pull)" }}.</p>
    {% if r.hosts is not none %}<p>{{ r.hosts }} host{{ "" if r.hosts == 1 else "s" }}{% if r.groups is not none %}, {{ r.groups }} group{{ "" if r.groups == 1 else "s" }}{% endif %} in the inventory.</p>{% endif %}
    {% if r.warning %}<p class="form-error" role="alert" data-field="test-pull-warning">Warning: {{ r.warning }}</p>{% endif %}
    {% endif %}
    {% if tp.status == "failed" %}<p class="form-error" role="alert" data-field="test-pull">{{ tp.error_class }}: {{ tp.error_message }}</p>{% endif %}
  </div>
  {% else %}<p id="test-pull-result">No test pull has run yet.</p>{% endif %}
  {% endblock %}
  {% endif %}
  {% endif %}
</section>
{% endblock %}
{% endblock %}
{% block scripts %}
<script src="/static/settings.js" defer></script>
{% endblock %}
