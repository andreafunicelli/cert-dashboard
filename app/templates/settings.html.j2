{% extends "base.html.j2" %}
{% block title %}Settings · Cert Dashboard{% endblock %}
{% block content %}
<h1>Settings</h1>
<nav class="tabs" aria-label="Settings sections">
  <ul>
  {% for item in tabs %}
    <li><a href="/settings?tab={{ item.name }}"{% if item.name == tab %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
  {% endfor %}
  </ul>
</nav>
{% block panel %}
{% macro disabled_action(label, reason) %}<p class="action-disabled"><button type="button" disabled aria-disabled="true">{{ label }}</button> <span class="hint">{{ reason }}</span></p>{% endmacro %}
<section class="panel wide" id="settings-panel" data-tab="{{ tab }}" aria-labelledby="tab-heading">
  <h2 id="tab-heading">{{ tab_label }}</h2>
  {% if saved %}<p class="notice" role="status">Settings saved.</p>{% endif %}
  {% if errors.get("form") %}<div class="form-error" data-field="form" role="alert">{% for message in errors["form"] %}<p>{{ message }}</p>{% endfor %}</div>{% endif %}
  {% if tab == "trust" %}
  <p data-public-bundle>Public bundle: certifi {{ bundle.version }}, {{ bundle.roots }} roots, include-public-bundle = {{ "true" if bundle.enabled else "false" }}</p>
  <p class="hint">The public roots are read-only, in-memory entries of the pinned certifi bundle; they are never listed or stored as rows.</p>
  <form method="post" action="/settings/trust">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    <input type="hidden" name="include_public_bundle" value="false">
    <label for="f-include-public-bundle" class="checkbox"><input type="checkbox" id="f-include-public-bundle" name="include_public_bundle" value="true"{% if bundle.enabled %} checked{% endif %}> Trust the public CA bundle</label>
    <p class="hint">Saving rechecks the stored chain statuses immediately.</p>
    <button type="submit">Save and recheck</button>
  </form>

  <h3>Uploaded trust anchors</h3>
  {% if anchors %}
  <table>
    <thead><tr><th>Subject</th><th>SHA-256 fingerprint</th><th>Source</th><th>Notes</th><th>Added</th><th>Added by</th><th>Remove</th></tr></thead>
    <tbody>
    {% for a in anchors %}
      <tr data-anchor="{{ a.id }}">
        <td>{{ a.subject }}</td>
        <td><code>{{ a.fingerprint }}</code></td>
        <td>{{ a.source }}</td>
        <td>{{ a.notes }}</td>
        <td>{{ time_tag(a.created_at, timezone) }}</td>
        <td>{{ a.created_by }}</td>
        <td>
          <form method="post" action="/settings/trust-anchors/{{ a.id }}/delete">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
            <label for="f-delete-{{ a.id }}">Type DELETE to confirm</label>
            <input id="f-delete-{{ a.id }}" name="confirm" autocomplete="off" required>
            <button type="submit">Delete</button>
          </form>
        </td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  {% else %}
  <p>No uploaded trust anchors.</p>
  {% endif %}

  <h3>Add an internal root</h3>
  <form method="post" action="/settings/trust-anchors" enctype="multipart/form-data">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    <label for="f-anchor-file">PEM file</label>
    <input type="file" id="f-anchor-file" name="file" accept=".pem,.crt,.cer">
    <label for="f-anchor-pem">or paste one PEM certificate</label>
    <textarea id="f-anchor-pem" name="pem" rows="6" autocomplete="off"></textarea>
    <p class="hint">One self-signed CA root (CA:TRUE, certificate-signing key usage), at most 1,048,576 bytes. Saving rechecks the stored chain statuses immediately.</p>
    <label for="f-anchor-notes">Notes</label>
    <input id="f-anchor-notes" name="notes" maxlength="{{ max_notes }}" autocomplete="off">
    <button type="submit">Add trust anchor</button>
  </form>
  {% elif tab == "status" %}
  {% set k = snapshot.keyring %}{% set w = snapshot.worker %}{% set q = snapshot.queue %}
  <h3>Warnings</h3>
  {% if snapshot.warnings %}
  <ul class="warnings">{% for code in snapshot.warnings %}<li data-warning="{{ code }}">{{ warning_text[code] }}</li>{% endfor %}</ul>
  {% else %}<p>No warnings.</p>{% endif %}

  <h3>Worker</h3>
  <ul>
    <li>State: <strong data-worker-state="{{ w.state }}">{{ w.state }}</strong></li>
    <li>Last heartbeat: {{ time_tag(when(w.last_seen_at), timezone) }}</li>
    <li>Heartbeat every {{ w.heartbeat_interval_seconds }} seconds; stale after {{ w.stale_after_seconds // 60 }} minutes</li>
    <li>Live workers: {{ w.workers }}</li>
  </ul>

  <h3>Queue</h3>
  <ul>
    <li>Queued {{ q.queued }}</li>
    <li>Running {{ q.running }}</li>
    <li>Paused {{ q.paused }}</li>
    <li>Failed in the last 24 hours {{ q.failed_24h }}</li>
  </ul>

  <h3>Keyring</h3>
  <ul>
    <li>Active version {{ k.active_version }}</li>
    <li>Loaded versions: {{ k.loaded_versions | join(", ") }}</li>
    <li>File SHA-256: <code>{{ k.file_sha256 or "unknown" }}</code></li>
    <li>Versions referenced by stored keys but missing from the keyring: {{ k.missing_versions | join(", ") or "none" }}</li>
    <li>Rows not yet on the active version: {{ k.stale_rows }}</li>
  </ul>

  <h3>Database</h3>
  <p>Database size: {{ db_size }}</p>

  <h3>Last runs</h3>
  {% if snapshot.last_runs %}
  <table>
    <thead><tr><th>Schedule</th><th>Last run</th></tr></thead>
    <tbody>{% for key, value in snapshot.last_runs.items() %}<tr><td>{{ key }}</td><td>{{ time_tag(when(value), timezone) }}</td></tr>{% endfor %}</tbody>
  </table>
  {% else %}<p>No scheduled run has been recorded yet.</p>{% endif %}
  {% if snapshot.last_jobs %}
  <table>
    <thead><tr><th>Job type</th><th>Last finished job</th><th>Finished</th></tr></thead>
    <tbody>{% for key, value in snapshot.last_jobs.items() %}<tr><td>{{ key }}</td><td>{{ value.status }}</td><td>{{ time_tag(when(value.finished_at), timezone) }}</td></tr>{% endfor %}</tbody>
  </table>
  {% else %}<p>No job has finished yet.</p>{% endif %}
  {% elif tab == "maintenance" %}
  {% set k = snapshot.keyring %}
  <h3>Master key rotation</h3>
  <p>Rotation is a command-line operation; this page never edits the keyring or rotates keys. Current state:</p>
  <ul>
    <li>Active version {{ k.active_version }}; loaded versions: {{ k.loaded_versions | join(", ") }}</li>
    <li>Rows not yet on the active version: {{ k.stale_rows }}</li>
    <li>Versions referenced by stored keys but missing from the keyring: {{ k.missing_versions | join(", ") or "none" }}</li>
  </ul>
  <p>Run these on the dashboard host as root (full procedure: <code>docs/operations.md</code>, section 6). Take a database backup first.</p>
  <ol>
    <li>Generate the next version into a <strong>new</strong> file in a temporary <code>0700</code> directory owned by the container user, merging the current keyring (live limit: two versions). The current <code>master_key</code> is mounted read-only at <code>/secrets</code> and the new file is written to <code>/out</code>; both paths exist only inside this one <code>docker run</code>:
      <pre><code>set -eu
tmp="$(mktemp -d /tmp/cert-dashboard-keyring.XXXXXXXX)"
install -d -m 0700 -o 10001 -g 10001 "$tmp"
docker run --rm -v /etc/cert-dashboard/secrets:/secrets:ro -v "$tmp":/out cert-dashboard:local \
  python -m app.cli generate-master-key --version {{ next_version }} --merge /secrets/master_key --output /out/master_key.v{{ next_version }}.new
sha256sum "$tmp/master_key.v{{ next_version }}.new"</code></pre>
      The command prints only <code>sha256=&lt;digest&gt; path=&lt;file&gt;</code>; the digest must equal the <code>sha256sum</code> output.</li>
    <li>Keep a copy of the old file in the backup location, install the verified file as the <code>master_key</code> secret and restart so new writes use it:
      <pre><code>install -m 0400 -o 10001 -g 10001 "$tmp/master_key.v{{ next_version }}.new" /etc/cert-dashboard/secrets/master_key
shred -u -- "$tmp/master_key.v{{ next_version }}.new" &amp;&amp; rmdir -- "$tmp"
docker compose up -d --force-recreate web worker</code></pre></li>
    <li>Re-encrypt every key and TOTP seed (batched, idempotent, resumable):
      <pre><code>docker compose run --rm web python -m app.cli rotate-master-key</code></pre></li>
    <li>Verify a keyed certificate (metadata only is printed):
      <pre><code>docker compose run --rm web python -m app.cli verify-key --certificate-id ID</code></pre></li>
  </ol>
  <p class="hint">Secret files are read once at startup: replace the file, rerun <code>scripts/install-secrets.sh</code> and restart the service.</p>

  <h3>Prune old jobs</h3>
  <p>Queues the retention cleanup now: finished jobs older than the retention period, old scan results, expired sessions and old artifacts are removed. Audit rows are never removed.</p>
  <form method="post" action="/settings/maintenance/prune">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    <label for="f-prune-confirm">Type {{ prune_confirmation }} to confirm</label>
    <input id="f-prune-confirm" name="confirm" autocomplete="off" required>
    <button type="submit">Queue retention cleanup</button>
  </form>
  {% else %}
  <form method="post" action="/settings/{{ tab }}" hx-post="/settings/{{ tab }}" hx-target="#settings-panel" hx-swap="outerHTML" hx-select="#settings-panel">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    {% for f in fields %}
      {% if f.widget == "checkbox" %}
    <input type="hidden" name="{{ f.name }}" value="false">
    <label for="f-{{ f.name }}" class="checkbox"><input type="checkbox" id="f-{{ f.name }}" name="{{ f.name }}" value="true"{% if values[f.name] %} checked{% endif %}> {{ f.label }}</label>
      {% elif f.widget == "select" %}
    <label for="f-{{ f.name }}">{{ f.label }}</label>
    <select id="f-{{ f.name }}" name="{{ f.name }}">
      {% for option, text in f.choices %}<option value="{{ option }}"{% if values[f.name] == option %} selected{% endif %}>{{ text }}</option>{% endfor %}
    </select>
      {% elif f.widget == "textarea" %}
    <label for="f-{{ f.name }}">{{ f.label }}</label>
    <textarea id="f-{{ f.name }}" name="{{ f.name }}" rows="6" maxlength="20000">{{ values[f.name] }}</textarea>
      {% else %}
    <label for="f-{{ f.name }}">{{ f.label }}</label>
    <input id="f-{{ f.name }}" name="{{ f.name }}" value="{{ values[f.name] }}" maxlength="600" autocomplete="off"{% if f.placeholder %} placeholder="{{ f.placeholder }}"{% endif %}>
      {% endif %}
      {% if f.hint %}<p class="hint">{{ f.hint }}</p>{% endif %}
      {% if errors.get(f.name) %}<div class="form-error" data-field="{{ f.name }}" role="alert">{% for message in errors[f.name] %}<p>{{ f.label }} {{ message }}</p>{% endfor %}</div>{% endif %}
    {% endfor %}
    <button type="submit">Save {{ tab_label }} settings</button>
  </form>
  {% if tab == "smtp" %}
  {% if tls_unsafe %}<p class="form-error" role="alert" data-warning="tls-verify">unsafe: TLS certificate verification disabled — mail credentials and content can be intercepted.</p>{% endif %}
  <p class="hint">SMTP password: provided only via the worker secret file <code>smtp_password</code>; not settable or visible here.</p>
  {% if disabled.get("test_email") %}{{ disabled_action("Send test email", disabled["test_email"]) }}
  {% else %}<form method="post" action="/settings/smtp/test"><input type="hidden" name="csrf_token" value="{{ csrf_token }}"><button type="submit">Send test email</button></form>{% endif %}
  {% elif tab == "inventory" %}
  {% if disabled.get("test_pull") %}{{ disabled_action("Test pull", disabled["test_pull"]) }}
  {% else %}<form method="post" action="/settings/inventory/test-pull"><input type="hidden" name="csrf_token" value="{{ csrf_token }}"><button type="submit">Test pull</button></form>{% endif %}
  {% endif %}
  {% endif %}
</section>
{% endblock %}
{% endblock %}
{% block scripts %}
<script>
  // htmx ignores 4xx bodies by default; a refused save answers 422 with the re-rendered panel.
  document.body.addEventListener("htmx:beforeSwap", function (event) {
    if (event.detail.xhr.status === 422) { event.detail.shouldSwap = true; event.detail.isError = false; }
  });
</script>
{% endblock %}
